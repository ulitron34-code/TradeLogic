NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform?schema=public
DIRECT_URL=postgresql://platform:platform@localhost:5432/platform?schema=public
REDIS_URL=redis://localhost:6379
# Proyecto Supabase (Project Settings -> API). SUPABASE_URL se usa para validar
# JWTs de Supabase Auth via JWKS; SUPABASE_SERVICE_ROLE_KEY es opcional, solo
# para acciones administrativas futuras (invitar usuarios, etc).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Deja en false salvo en desarrollo local sin Supabase Auth configurado.
DEV_AUTH_BYPASS=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=platform-local
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
JWT_ISSUER=platform-local
JWT_AUDIENCE=platform-web
JWT_SECRET=replace-with-at-least-32-characters
ENCRYPTION_KEY=replace-with-32-byte-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FX_PROVIDER=banxico
REGULATORY_POLL_CRON=0 * * * 1-5
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
