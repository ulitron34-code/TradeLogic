NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform?schema=public
DIRECT_URL=postgresql://platform:platform@localhost:5432/platform?schema=public
# Optional legacy compatibility setting; production queues use PostgreSQL.
REDIS_URL=
# Proyecto Supabase (Project Settings -> API). SUPABASE_URL se usa para validar
# JWTs de Supabase Auth via JWKS; SUPABASE_SERVICE_ROLE_KEY es opcional, solo
# para acciones administrativas futuras (invitar usuarios, etc).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Deja en false salvo en desarrollo local sin Supabase Auth configurado.
DEV_AUTH_BYPASS=false
# Solo para permitir el bypass anterior con NODE_ENV=production (pruebas
# puntuales sobre un despliegue real). Dejar en false siempre que se pueda;
# si se activa, revertir a false apenas terminen las pruebas.
ALLOW_DEV_BYPASS_IN_PRODUCTION=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=platform-local
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
JWT_ISSUER=platform-local
JWT_AUDIENCE=platform-web
JWT_SECRET=replace-with-at-least-32-characters
ENCRYPTION_KEY=replace-with-32-byte-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FX_PROVIDER=banxico
REGULATORY_POLL_CRON=0 * * * 1-5
JURISPRUDENCE_POLL_CRON=0 3 * * 1
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
