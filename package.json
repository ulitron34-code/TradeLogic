{
  "name": "aduana-intelligence-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @platform/db prisma:generate",
    "db:migrate": "pnpm --filter @platform/db prisma:migrate",
    "db:studio": "pnpm --filter @platform/db prisma:studio",
    "db:tariff-import": "pnpm --filter @platform/db tariff:import --",
    "verify:structure": "node scripts/verify-structure.cjs",
    "preflight:win": "powershell -ExecutionPolicy Bypass -File scripts/preflight-local.ps1",
    "preflight:sh": "sh scripts/preflight-local.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
