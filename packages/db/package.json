{
  "name": "@platform/db",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "import": "./dist/index.js",
    "default": "./dist/index.js"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prisma:seed": "tsx prisma/seed.ts",
    "tariff:import": "tsx ../../scripts/import-tariff-catalog.ts",
    "regulatory:import": "tsx ../../scripts/import-regulatory-catalog.ts",
    "origin-rules:import": "tsx ../../scripts/import-origin-rules.ts",
    "senasica:import": "tsx ../../corpus/scripts/import-senasica-catalog.ts",
    "corpus:extract-ligie": "pwsh -File ../../corpus/scripts/extract-ligie-corpus.ps1",
    "corpus:transform-senasica": "python ../../corpus/scripts/transform-senasica.py"
  },
  "dependencies": {
    "@platform/domain": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  }
}
